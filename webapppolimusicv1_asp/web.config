<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  web.config - Configuracion del sitio para IIS / IIS Express.
  Proyecto: WebAppPoliMusicV1 (ASP clasico + SQL Server)
  ============================================================================

  IMPORTANTE - Por que aqui NO aparece la seccion <asp>:

  La seccion de configuracion "system.webServer/asp" esta BLOQUEADA a nivel
  de servidor en IIS:

      <section name="asp" overrideModeDefault="Deny" />

  Ese bloqueo es parte de applicationHost.config (el archivo de configuracion
  del servidor) y NO puede modificarse desde un web.config de aplicacion.
  Si se intenta, IIS responde:

      HTTP 501 - "Error en nueva aplicacion"

  Se verifico experimentalmente: declarar <asp>, <asp><session> o
  <asp><limits> en este archivo produce HTTP 501, mientras que el resto de
  secciones responden HTTP 200.

  Ademas, la seccion <asp> es INNECESARIA aqui, porque los valores que se
  querian fijar ya son los valores por defecto documentados por Microsoft:

      allowSessionState = true        (por defecto)
      timeout           = 00:20:00    (por defecto)

  Referencias:
    - "ASP Session <session>"          learn.microsoft.com/iis/configuration/
                                        system.webserver/asp/session
    - "ASP <asp>"                      learn.microsoft.com/iis/configuration/
                                        system.webserver/asp
    - Los ejemplos oficiales de Microsoft configuran <asp> mediante
      AppCmd.exe con "/commit:apphost" o GetApplicationHostConfiguration(),
      es decir, SIEMPRE contra applicationHost.config, nunca contra web.config.

  Si el servidor necesitara ajustar ASP (por ejemplo subir scriptTimeout),
  debe hacerse a nivel de servidor, por ejemplo:

      %windir%\system32\inetsrv\appcmd.exe set config ^
        -section:system.webServer/asp /limits.scriptTimeout:"00:01:30" ^
        /commit:apphost

  Con esto el archivo queda reducido a lo que SI es sobreescribible desde la
  aplicacion, evitando el error 501 y sin duplicar configuracion del servidor.
  ============================================================================
-->
<configuration>

  <system.webServer>

    <!--
      Documento predeterminado del sitio.
      Se limpia la lista heredada y se deja solo login.asp, de modo que la
      raiz del sitio muestre la pantalla de inicio de sesion.
    -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="login.asp" />
      </files>
    </defaultDocument>

    <!--
      Tipo MIME del audio reproducido por el reproductor (HTML5 <audio>).
      El "remove" previo evita el error 500.19 "entrada duplicada" en caso de
      que el servidor ya tenga registrada la extension .mp3.
    -->
    <staticContent>
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
    </staticContent>

    <!-- Sin exploracion de directorios (no exponer listados de carpetas). -->
    <directoryBrowse enabled="false" />

  </system.webServer>

</configuration>
